#!/usr/bin/env bash

set -Eeuo pipefail

readonly APTLY_CONFIG="${APTLY_CONFIG:-/etc/aptly.conf}"
readonly APTLY_ROOT="${APTLY_ROOT:-/var/lib/aptly}"
readonly GNUPGHOME="${GNUPGHOME:-/var/lib/prvaptmirror/gnupg}"
readonly INCOMING_ROOT="${INCOMING_ROOT:-/incoming}"
readonly PUBLIC_ROOT="${PUBLIC_ROOT:-/var/public}"
readonly STATE_ROOT="${STATE_ROOT:-/var/lib/aptly/prvaptmirror-state}"
readonly REPO_COMPONENT="${REPO_COMPONENT:-main}"
readonly REPO_ARCHITECTURES="${REPO_ARCHITECTURES:-amd64,arm64,armhf}"
readonly PUBLISH_ENDPOINT_NAME="${PUBLISH_ENDPOINT_NAME:-public}"

export GNUPGHOME

log() {
    printf '[repoctl] %s\n' "$*"
}

die() {
    printf '[repoctl] 错误：%s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
PrvAptMirror 仓库管理命令

用法：
  repoctl init
  repoctl repo create <family> <suite>
  repoctl package add <family> <suite> <deb-path>
  repoctl package list <family> <suite>
  repoctl snapshot list <family> <suite>
  repoctl rollback <family> <suite> [snapshot]
  repoctl key export
  repoctl help

示例：
  repoctl init
  repoctl repo create ubuntu noble
  repoctl package add ubuntu noble /incoming/example_1.0.0_arm64.deb
EOF
}

aptly_cmd() {
    aptly -config="${APTLY_CONFIG}" "$@"
}

prepare_directories() {
    [[ -f "${APTLY_CONFIG}" ]] || die "找不到 Aptly 配置：${APTLY_CONFIG}"

    mkdir -p "${APTLY_ROOT}" "${GNUPGHOME}" "${PUBLIC_ROOT}" "${STATE_ROOT}"
    chown -R "$(id -u):$(id -g)" "${GNUPGHOME}"
    chmod 0700 "${GNUPGHOME}"
    chmod 0755 "${APTLY_ROOT}" "${PUBLIC_ROOT}" "${STATE_ROOT}"
}

acquire_write_lock() {
    exec 9>"${STATE_ROOT}/repoctl.lock"
    flock -n 9 || die "另一个 repoctl 写入任务正在运行，请稍后重试"
}

validate_token() {
    local label="$1"
    local value="$2"

    [[ "${value}" =~ ^[a-z0-9][a-z0-9.+-]*$ ]] \
        || die "${label} 只能包含小写字母、数字、点、加号和连字符：${value}"
}

repo_name() {
    printf '%s-%s\n' "$1" "$2"
}

publish_endpoint() {
    printf 'filesystem:%s:%s\n' "${PUBLISH_ENDPOINT_NAME}" "$1"
}

state_file() {
    printf '%s/%s-%s.current\n' "${STATE_ROOT}" "$1" "$2"
}

secret_key_fingerprint() {
    local selector="${REPO_GPG_KEY:-}"
    local fingerprint

    fingerprint="$({
        if [[ -n "${selector}" ]]; then
            gpg --batch --with-colons --list-secret-keys "${selector}"
        else
            gpg --batch --with-colons --list-secret-keys
        fi
    } 2>/dev/null | awk -F: '$1 == "fpr" { print $10; exit }')"

    [[ -n "${fingerprint}" ]] || return 1
    printf '%s\n' "${fingerprint}"
}

export_public_key() {
    local fingerprint="$1"
    local binary_tmp="${PUBLIC_ROOT}/.repository-key.gpg.tmp"
    local armor_tmp="${PUBLIC_ROOT}/.repository-key.asc.tmp"

    gpg --batch --yes --output "${binary_tmp}" --export "${fingerprint}"
    gpg --batch --yes --armor --output "${armor_tmp}" --export "${fingerprint}"
    chmod 0644 "${binary_tmp}" "${armor_tmp}"
    mv -f "${binary_tmp}" "${PUBLIC_ROOT}/repository-key.gpg"
    mv -f "${armor_tmp}" "${PUBLIC_ROOT}/repository-key.asc"
    log "已导出公钥：${PUBLIC_ROOT}/repository-key.gpg"
}

cmd_init() {
    local fingerprint
    local identity

    prepare_directories
    acquire_write_lock

    if fingerprint="$(secret_key_fingerprint)"; then
        log "签名密钥已经存在：${fingerprint}"
    else
        identity="${REPO_GPG_NAME:-PrvAptMirror Archive} <${REPO_GPG_EMAIL:-apt@example.invalid}>"
        log "正在生成仓库签名密钥：${identity}"
        gpg --batch \
            --pinentry-mode loopback \
            --passphrase '' \
            --quick-generate-key \
            "${identity}" \
            rsa3072 \
            sign \
            "${REPO_GPG_EXPIRE:-2y}"
        fingerprint="$(secret_key_fingerprint)" \
            || die "GPG 密钥生成完成，但无法读取密钥指纹"
        log "签名密钥已生成：${fingerprint}"
    fi

    export_public_key "${fingerprint}"
    log "初始化完成"
}

require_signing_key() {
    local fingerprint

    fingerprint="$(secret_key_fingerprint)" \
        || die "尚未初始化签名密钥，请先执行 repoctl init"
    printf '%s\n' "${fingerprint}"
}

repo_exists() {
    aptly_cmd repo show "$1" >/dev/null 2>&1
}

snapshot_exists() {
    aptly_cmd snapshot show "$1" >/dev/null 2>&1
}

cmd_repo_create() {
    [[ $# -eq 2 ]] || die "用法：repoctl repo create <family> <suite>"

    local family="$1"
    local suite="$2"
    local repository

    validate_token "family" "${family}"
    validate_token "suite" "${suite}"
    prepare_directories
    acquire_write_lock
    repository="$(repo_name "${family}" "${suite}")"

    if repo_exists "${repository}"; then
        log "仓库已经存在：${repository}"
        return 0
    fi

    aptly_cmd repo create \
        -comment="PrvAptMirror ${family}/${suite}" \
        -component="${REPO_COMPONENT}" \
        -distribution="${suite}" \
        -architectures="${REPO_ARCHITECTURES}" \
        "${repository}"
    log "仓库已创建：${repository}"
}

architecture_allowed() {
    local package_architecture="$1"
    local allowed

    [[ "${package_architecture}" == "all" ]] && return 0
    IFS=',' read -r -a allowed <<<"${REPO_ARCHITECTURES}"
    local architecture
    for architecture in "${allowed[@]}"; do
        [[ "${package_architecture}" == "${architecture}" ]] && return 0
    done
    return 1
}

validate_deb() {
    local requested_path="$1"
    local resolved_path
    local package_name
    local package_version
    local package_architecture

    [[ -f "${requested_path}" ]] || die "软件包不存在或不是普通文件：${requested_path}"
    resolved_path="$(readlink -f -- "${requested_path}")"
    case "${resolved_path}" in
        "${INCOMING_ROOT}"/*.deb) ;;
        *) die "只能导入 ${INCOMING_ROOT} 下的 .deb 文件：${requested_path}" ;;
    esac

    dpkg-deb --info "${resolved_path}" >/dev/null \
        || die "无效的 Debian 软件包：${requested_path}"

    package_name="$(dpkg-deb -f "${resolved_path}" Package)"
    package_version="$(dpkg-deb -f "${resolved_path}" Version)"
    package_architecture="$(dpkg-deb -f "${resolved_path}" Architecture)"

    dpkg --validate-pkgname "${package_name}" >/dev/null 2>&1 \
        || die "软件包名称无效：${package_name}"
    dpkg --validate-version "${package_version}" >/dev/null 2>&1 \
        || die "软件包版本无效：${package_version}"
    architecture_allowed "${package_architecture}" \
        || die "不允许的软件包架构：${package_architecture}；允许值为 ${REPO_ARCHITECTURES},all"

    printf '%s\t%s\t%s\t%s\n' \
        "${resolved_path}" "${package_name}" "${package_version}" "${package_architecture}"
}

unique_snapshot_name() {
    local repository="$1"
    local base="${repository}-$(date -u +%Y%m%dT%H%M%S%NZ)"
    local candidate="${base}"
    local counter=1

    while snapshot_exists "${candidate}"; do
        candidate="${base}-${counter}"
        counter=$((counter + 1))
    done
    printf '%s\n' "${candidate}"
}

published_release_exists() {
    local family="$1"
    local suite="$2"
    [[ -f "${PUBLIC_ROOT}/${family}/dists/${suite}/Release" ]]
}

record_current_snapshot() {
    local family="$1"
    local suite="$2"
    local snapshot="$3"
    local target
    local temporary

    target="$(state_file "${family}" "${suite}")"
    temporary="${target}.tmp"
    printf '%s\n' "${snapshot}" >"${temporary}"
    mv -f "${temporary}" "${target}"
}

publish_snapshot() {
    local family="$1"
    local suite="$2"
    local snapshot="$3"
    local fingerprint="$4"
    local endpoint

    endpoint="$(publish_endpoint "${family}")"
    if published_release_exists "${family}" "${suite}"; then
        aptly_cmd publish switch \
            -batch \
            -gpg-key="${fingerprint}" \
            "${suite}" \
            "${endpoint}" \
            "${snapshot}"
    else
        aptly_cmd publish snapshot \
            -batch \
            -gpg-key="${fingerprint}" \
            -distribution="${suite}" \
            -component="${REPO_COMPONENT}" \
            -architectures="${REPO_ARCHITECTURES}" \
            "${snapshot}" \
            "${endpoint}"
    fi

    record_current_snapshot "${family}" "${suite}" "${snapshot}"
    chmod -R a+rX "${PUBLIC_ROOT}"
}

check_publication() {
    local family="$1"
    local suite="$2"
    local release_root="${PUBLIC_ROOT}/${family}/dists/${suite}"

    [[ -s "${release_root}/InRelease" ]] \
        || die "发布后未找到有效的 InRelease：${release_root}/InRelease"
    [[ -s "${release_root}/Release" ]] \
        || die "发布后未找到有效的 Release：${release_root}/Release"
    [[ -s "${PUBLIC_ROOT}/repository-key.gpg" ]] \
        || die "发布目录中缺少 repository-key.gpg"
}

cmd_package_add() {
    [[ $# -eq 3 ]] || die "用法：repoctl package add <family> <suite> <deb-path>"

    local family="$1"
    local suite="$2"
    local requested_path="$3"
    local repository
    local package_path
    local package_name
    local package_version
    local package_architecture
    local fingerprint
    local snapshot

    validate_token "family" "${family}"
    validate_token "suite" "${suite}"
    prepare_directories
    acquire_write_lock
    repository="$(repo_name "${family}" "${suite}")"
    repo_exists "${repository}" \
        || die "仓库不存在：${repository}；请先执行 repoctl repo create ${family} ${suite}"
    fingerprint="$(require_signing_key)"

    IFS=$'\t' read -r package_path package_name package_version package_architecture \
        < <(validate_deb "${requested_path}")
    log "正在导入 ${package_name} ${package_version} (${package_architecture})"
    aptly_cmd repo add "${repository}" "${package_path}"

    snapshot="$(unique_snapshot_name "${repository}")"
    aptly_cmd snapshot create "${snapshot}" from repo "${repository}"
    publish_snapshot "${family}" "${suite}" "${snapshot}" "${fingerprint}"
    check_publication "${family}" "${suite}"

    log "发布完成：${family}/${suite} -> ${snapshot}"
}

cmd_package_list() {
    [[ $# -eq 2 ]] || die "用法：repoctl package list <family> <suite>"

    local family="$1"
    local suite="$2"
    local repository

    validate_token "family" "${family}"
    validate_token "suite" "${suite}"
    prepare_directories
    repository="$(repo_name "${family}" "${suite}")"
    repo_exists "${repository}" || die "仓库不存在：${repository}"
    aptly_cmd repo show -with-packages "${repository}"
}

list_snapshots() {
    local repository="$1"
    aptly_cmd snapshot list -raw | awk -v prefix="${repository}-" 'index($0, prefix) == 1'
}

cmd_snapshot_list() {
    [[ $# -eq 2 ]] || die "用法：repoctl snapshot list <family> <suite>"

    local family="$1"
    local suite="$2"

    validate_token "family" "${family}"
    validate_token "suite" "${suite}"
    prepare_directories
    list_snapshots "$(repo_name "${family}" "${suite}")"
}

cmd_rollback() {
    [[ $# -ge 2 && $# -le 3 ]] \
        || die "用法：repoctl rollback <family> <suite> [snapshot]"

    local family="$1"
    local suite="$2"
    local requested_snapshot="${3:-}"
    local repository
    local current_file
    local current
    local target=""
    local fingerprint
    local endpoint
    local index
    local -a snapshots=()

    validate_token "family" "${family}"
    validate_token "suite" "${suite}"
    prepare_directories
    acquire_write_lock
    repository="$(repo_name "${family}" "${suite}")"
    current_file="$(state_file "${family}" "${suite}")"
    [[ -s "${current_file}" ]] \
        || die "没有找到当前快照状态，无法自动回滚：${family}/${suite}"
    current="$(<"${current_file}")"

    mapfile -t snapshots < <(list_snapshots "${repository}" | LC_ALL=C sort)
    [[ ${#snapshots[@]} -gt 0 ]] || die "没有可用快照：${repository}"

    if [[ -n "${requested_snapshot}" ]]; then
        [[ "${requested_snapshot}" == "${repository}-"* ]] \
            || die "快照不属于仓库 ${repository}：${requested_snapshot}"
        snapshot_exists "${requested_snapshot}" \
            || die "快照不存在：${requested_snapshot}"
        target="${requested_snapshot}"
    else
        for index in "${!snapshots[@]}"; do
            if [[ "${snapshots[index]}" == "${current}" ]]; then
                (( index > 0 )) || die "当前已经是最早的快照，无法继续回滚"
                target="${snapshots[index - 1]}"
                break
            fi
        done
        [[ -n "${target}" ]] \
            || die "当前快照不在 Aptly 快照列表中：${current}"
    fi

    [[ "${target}" != "${current}" ]] || die "目标快照已经是当前版本：${target}"
    fingerprint="$(require_signing_key)"
    endpoint="$(publish_endpoint "${family}")"
    aptly_cmd publish switch \
        -batch \
        -gpg-key="${fingerprint}" \
        "${suite}" \
        "${endpoint}" \
        "${target}"
    record_current_snapshot "${family}" "${suite}" "${target}"
    chmod -R a+rX "${PUBLIC_ROOT}"
    check_publication "${family}" "${suite}"
    log "回滚完成：${family}/${suite} -> ${target}"
}

cmd_key_export() {
    [[ $# -eq 0 ]] || die "用法：repoctl key export"

    local fingerprint
    prepare_directories
    acquire_write_lock
    fingerprint="$(require_signing_key)"
    export_public_key "${fingerprint}"
    printf '%s\n' "${fingerprint}"
}

main() {
    local command="${1:-help}"
    [[ $# -eq 0 ]] || shift

    case "${command}" in
        init)
            [[ $# -eq 0 ]] || die "用法：repoctl init"
            cmd_init
            ;;
        repo)
            [[ "${1:-}" == "create" ]] || die "用法：repoctl repo create <family> <suite>"
            shift
            cmd_repo_create "$@"
            ;;
        package)
            case "${1:-}" in
                add)
                    shift
                    cmd_package_add "$@"
                    ;;
                list)
                    shift
                    cmd_package_list "$@"
                    ;;
                *) die "用法：repoctl package <add|list> ..." ;;
            esac
            ;;
        snapshot)
            [[ "${1:-}" == "list" ]] || die "用法：repoctl snapshot list <family> <suite>"
            shift
            cmd_snapshot_list "$@"
            ;;
        rollback)
            cmd_rollback "$@"
            ;;
        key)
            [[ "${1:-}" == "export" ]] || die "用法：repoctl key export"
            shift
            cmd_key_export "$@"
            ;;
        help|-h|--help)
            usage
            ;;
        *)
            usage >&2
            die "未知命令：${command}"
            ;;
    esac
}

main "$@"
