#!/usr/bin/env sh

set -eu

readonly JOB_ROOT="${JOB_ROOT:-/jobs}"
readonly READY_FILE="${JOB_ROOT}/.worker-ready"

cleanup() {
    rm -f -- "${READY_FILE}"
}

trap cleanup EXIT INT TERM

test -d "${JOB_ROOT}" || {
    printf '[repo-worker] 错误：任务目录不存在：%s\n' "${JOB_ROOT}" >&2
    exit 1
}

: >"${READY_FILE}"
printf '[repo-worker] Worker 基础服务已就绪；业务任务将在后续检查点接入\n'

while :; do
    sleep 30 &
    wait "$!"
done
