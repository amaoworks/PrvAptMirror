#!/usr/bin/env bash

set -Eeuo pipefail

readonly PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly COMPOSE_FILE="${PROJECT_ROOT}/compose.yaml"

compose() {
    local -a options=(-f "${COMPOSE_FILE}")
    if [[ -f "${PROJECT_ROOT}/.env" ]]; then
        options+=(--env-file "${PROJECT_ROOT}/.env")
    fi
    docker compose "${options[@]}" "$@"
}

usage() {
    cat <<'EOF'
用法：
  ./scripts/prvaptmirror build
  ./scripts/prvaptmirror up
  ./scripts/prvaptmirror stop
  ./scripts/prvaptmirror logs
  ./scripts/prvaptmirror status
  ./scripts/prvaptmirror setup
  ./scripts/prvaptmirror repoctl <参数...>
  ./scripts/prvaptmirror test

示例：
  ./scripts/prvaptmirror up
  ./scripts/prvaptmirror setup
  ./scripts/prvaptmirror repoctl init
  ./scripts/prvaptmirror repoctl repo create ubuntu noble
  ./scripts/prvaptmirror repoctl package add ubuntu noble /incoming/example.deb
EOF
}

command -v docker >/dev/null 2>&1 || {
    printf '错误：找不到 docker 命令\n' >&2
    exit 1
}
docker compose version >/dev/null 2>&1 || {
    printf '错误：当前 Docker 未安装 Compose 插件\n' >&2
    exit 1
}

command_name="${1:-help}"
[[ $# -eq 0 ]] || shift

case "${command_name}" in
    build)
        compose --profile tools --profile test build "$@"
        ;;
    up)
        compose up -d --build bootstrap repo-web admin-web repo-worker "$@"
        ;;
    stop)
        compose stop repo-web admin-web repo-worker "$@"
        ;;
    logs)
        compose logs -f "$@"
        ;;
    status)
        compose ps -a "$@"
        ;;
    setup)
        compose exec -T admin-web python3 /app/manage.py setup-token "$@"
        ;;
    repoctl)
        compose run --rm repoctl "$@"
        ;;
    test)
        compose --profile test build admin-web-test
        compose --profile test run --rm admin-web-test "$@"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        usage >&2
        printf '错误：未知命令：%s\n' "${command_name}" >&2
        exit 1
        ;;
esac
