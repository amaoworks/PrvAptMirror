#!/usr/bin/env bash

set -Eeuo pipefail

readonly PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly COMPOSE_FILE="${PROJECT_ROOT}/deploy/compose/compose.yaml"

compose() {
    local -a options=(-f "${COMPOSE_FILE}")
    if [[ -f "${PROJECT_ROOT}/.env" ]]; then
        options+=(--env-file "${PROJECT_ROOT}/.env")
    fi
    docker compose "${options[@]}" "$@"
}

usage() {
    cat <<'EOF'
用法：
  ./scripts/prvaptmirror build
  ./scripts/prvaptmirror up
  ./scripts/prvaptmirror down
  ./scripts/prvaptmirror logs
  ./scripts/prvaptmirror status
  ./scripts/prvaptmirror repoctl <参数...>
  ./scripts/prvaptmirror admin <up|down|logs|status|hash-password|test>

示例：
  ./scripts/prvaptmirror repoctl init
  ./scripts/prvaptmirror repoctl repo create ubuntu noble
  ./scripts/prvaptmirror repoctl package add ubuntu noble /incoming/example.deb
  ./scripts/prvaptmirror admin hash-password
  ./scripts/prvaptmirror admin up
EOF
}

command -v docker >/dev/null 2>&1 || {
    printf '错误：找不到 docker 命令\n' >&2
    exit 1
}
docker compose version >/dev/null 2>&1 || {
    printf '错误：当前 Docker 未安装 Compose 插件\n' >&2
    exit 1
}

command_name="${1:-help}"
[[ $# -eq 0 ]] || shift

case "${command_name}" in
    build)
        compose --profile tools build repo-web repoctl admin-tools "$@"
        ;;
    up)
        compose up -d --build repo-web "$@"
        ;;
    down)
        compose down "$@"
        ;;
    logs)
        compose logs -f repo-web "$@"
        ;;
    status)
        compose --profile admin ps "$@"
        ;;
    repoctl)
        compose run --rm repoctl "$@"
        ;;
    admin)
        admin_command="${1:-help}"
        [[ $# -eq 0 ]] || shift
        case "${admin_command}" in
            up)
                compose --profile admin up -d --build admin-web "$@"
                ;;
            down)
                compose --profile admin stop admin-web "$@"
                ;;
            logs)
                compose --profile admin logs -f admin-web "$@"
                ;;
            status)
                compose --profile admin ps admin-web "$@"
                ;;
            hash-password)
                compose --profile tools run --rm admin-tools hash-password "$@"
                ;;
            test)
                compose --profile test build admin-web-test
                compose --profile test run --rm admin-web-test "$@"
                ;;
            help|-h|--help)
                usage
                ;;
            *)
                usage >&2
                printf '错误：未知 admin 命令：%s\n' "${admin_command}" >&2
                exit 1
                ;;
        esac
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        usage >&2
        printf '错误：未知命令：%s\n' "${command_name}" >&2
        exit 1
        ;;
esac
