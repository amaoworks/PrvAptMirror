# 所有 PrvAptMirror 应用数据只写入这个目录。相对路径以项目根目录为基准。
PRVAPTMIRROR_DATA_DIR=./data

# 公开 APT 下载入口，默认仅监听宿主机回环地址。
REPO_HTTP_BIND=127.0.0.1
REPO_HTTP_PORT=28080

# 管理入口。生产环境必须填写浏览器实际访问的 HTTPS Origin，不能带路径。
ADMIN_HTTP_BIND=127.0.0.1
ADMIN_HTTP_PORT=28081
ADMIN_PUBLIC_ORIGIN=https://apt-admin.example.com
ADMIN_USERNAME=admin
ADMIN_SESSION_TTL=28800
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_SETUP_MAX_FAILURES=10

# 仅供回环地址上的本地开发或 SSH 隧道测试；生产环境不要启用。
# ADMIN_ALLOW_INSECURE_ORIGIN=1

# 仓库策略。Architecture: all 软件包始终允许导入。
REPO_ARCHITECTURES=amd64,arm64,armhf
REPO_COMPONENT=main

# bootstrap 首次启动时自动生成 OpenPGP 仓库签名密钥。
# 私钥只写入 PRVAPTMIRROR_DATA_DIR/gnupg，不会进入 .env。
REPO_GPG_NAME=PrvAptMirror Archive
REPO_GPG_EMAIL=apt@example.com
REPO_GPG_EXPIRE=2y
REPO_GPG_MODE=generate

# 可选：覆盖本地镜像名称。
# REPO_WEB_IMAGE=prvaptmirror/repo-web:local
# REPOCTL_IMAGE=prvaptmirror/repoctl:local
# ADMIN_WEB_IMAGE=prvaptmirror/admin-web:local

# Docker Hub 无法访问时，可以覆盖构建所用的基础镜像。
# REPO_WEB_BASE_IMAGE=docker.m.daocloud.io/nginxinc/nginx-unprivileged:1.27-alpine
# REPOCTL_BASE_IMAGE=docker.m.daocloud.io/library/debian:bookworm-slim
# REPOCTL_APT_MIRROR=http://mirrors.163.com
# ADMIN_WEB_BASE_IMAGE=debian:bookworm-slim
